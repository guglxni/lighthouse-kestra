# Kestra engine for Heroku Container Registry — Supabase Postgres, no Docker socket.
FROM kestra/kestra:v0.21.0

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip \
        ffmpeg curl ca-certificates \
        libpq-dev build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY scripts/requirements.txt /app/requirements.txt
RUN pip3 install --no-cache-dir --break-system-packages \
        -r /app/requirements.txt psycopg[binary] httpx pyyaml

COPY scripts/ /app/scripts/
COPY flows/ /app/flows/

RUN find /app/flows -name '*.yaml' -print0 | xargs -0 sed -i \
    's|io.kestra.plugin.scripts.runner.docker.Docker|io.kestra.plugin.scripts.runner.process.Process|g'

COPY infra/cloud-kestra-entrypoint.sh /cloud-kestra-entrypoint.sh
RUN chmod +x /cloud-kestra-entrypoint.sh

ENTRYPOINT ["/cloud-kestra-entrypoint.sh"]
