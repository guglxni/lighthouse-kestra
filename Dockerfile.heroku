# Kestra on Heroku — build context is repo root (heroku.yml → web: Dockerfile.heroku).
FROM kestra/kestra:v0.21.0

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip \
        libpq-dev build-essential curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY infra/requirements-kestra-heroku.txt /app/requirements.txt
RUN pip3 install --no-cache-dir -r /app/requirements.txt

COPY scripts/ /app/scripts/
COPY flows/ /app/flows/

RUN find /app/flows -name '*.yaml' -print0 | xargs -0 sed -i \
    's|io.kestra.plugin.scripts.runner.docker.Docker|io.kestra.plugin.scripts.runner.process.Process|g'

COPY infra/cloud-kestra-entrypoint.sh /cloud-kestra-entrypoint.sh
RUN chmod +x /cloud-kestra-entrypoint.sh

ENTRYPOINT ["/cloud-kestra-entrypoint.sh"]
